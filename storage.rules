rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function conversationMember(conversationId) {
      return request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberIds;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /conversations/{conversationId}/{userId}/{fileName} {
      allow read: if conversationMember(conversationId);
      allow create: if conversationMember(conversationId)
        && request.auth.uid == userId
        && ((request.resource.contentType.matches('image/.*')
              && request.resource.size < 20 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
              && request.resource.size < 12 * 1024 * 1024));
      allow delete: if conversationMember(conversationId)
        && request.auth.uid == userId;
      allow update: if false;
    }
  }
}
