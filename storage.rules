rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function conversationMember(conversationId) {
      let conversation = firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data;
      return request.auth != null
        && (request.auth.uid in conversation.get('memberIds', [])
          || (conversation.get('conversationType', '') == 'direct'
            && (request.auth.uid == conversation.get('ownerId', '')
              || request.auth.uid == conversation.get('contactId', ''))));
    }

    function supportedDocumentUpload() {
      return request.resource.size < 50 * 1024 * 1024
        && (request.resource.contentType.matches('text/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'application/rtf'
          || request.resource.contentType == 'application/json'
          || request.resource.contentType == 'application/zip'
          || request.resource.contentType == 'application/gzip'
          || request.resource.contentType == 'application/x-rar-compressed'
          || request.resource.contentType == 'application/vnd.rar'
          || request.resource.contentType == 'application/x-7z-compressed'
          || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*')
          || request.resource.contentType.matches('application/vnd\\.oasis\\.opendocument\\..*'));
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /business/{userId}/{pageId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && ((fileName.matches('logo-.*') && request.resource.size < 5 * 1024 * 1024)
          || (fileName.matches('cover-.*') && request.resource.size < 8 * 1024 * 1024));
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /businessAds/{userId}/{pageId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 8 * 1024 * 1024;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId}/{userId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds
        && ((request.resource.contentType.matches('image/.*')
              && request.resource.size < 20 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
              && request.resource.size < 12 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
              && request.resource.size < 60 * 1024 * 1024)
          || supportedDocumentUpload());
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }

    match /conversations/{conversationId}/{userId}/{fileName} {
      allow read: if conversationMember(conversationId);
      allow create: if conversationMember(conversationId)
        && request.auth.uid == userId
        && ((request.resource.contentType.matches('image/.*')
              && request.resource.size < 20 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
              && request.resource.size < 12 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
              && request.resource.size < 60 * 1024 * 1024)
          || supportedDocumentUpload());
      allow delete: if conversationMember(conversationId)
        && request.auth.uid == userId;
      allow update: if false;
    }

    // Conversation media first lands in a private sender outbox. Only its
    // uploader may read it for legacy-client compatibility; no recipient can
    // access it until commitConversationMedia validates the participants,
    // immutable hash and MIME type then moves it to the canonical path.
    match /conversationUploads/{userId}/{conversationId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && ((request.resource.contentType.matches('image/.*')
              && request.resource.size < 20 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
              && request.resource.size < 12 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
              && request.resource.size < 60 * 1024 * 1024)
          || supportedDocumentUpload());
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    match /stories/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && ((request.resource.contentType.matches('image/.*')
              && request.resource.size < 12 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
              && request.resource.size < 50 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
              && request.resource.size < 25 * 1024 * 1024));
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    match /radio/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size < 80 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    match /twins/{userId}/{fileName} {
      allow read, delete: if request.auth != null
        && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && firestore.get(/databases/(default)/documents/users/$(userId)/twinProfiles/main).data.identityConsent == true
        && firestore.get(/databases/(default)/documents/users/$(userId)/twinProfiles/main).data.voiceConsent == true
        && firestore.get(/databases/(default)/documents/users/$(userId)/twinProfiles/main).data.movementConsent == true
        && request.resource.size < 80 * 1024 * 1024
        && (request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
          || (fileName.matches('outfit-.*')
            && request.resource.contentType.matches('image/(jpeg|png|webp)')
            && request.resource.size < 10 * 1024 * 1024));
      allow update: if false;
    }
  }
}
