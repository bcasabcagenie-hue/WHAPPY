rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function whappyFounder() {
      return signedIn() && request.auth.token.phone_number == "+242065465808";
    }

    function belongsToConversation() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if ownsProfile(userId);

      match /devices/{deviceId} {
        allow read, delete: if ownsProfile(userId);
        allow create, update: if ownsProfile(userId)
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.platform == "android"
          && request.resource.data.enabled is bool;
      }

      match /twinProfiles/{profileId} {
        allow read, delete: if ownsProfile(userId) && profileId == "main";
        allow create, update: if ownsProfile(userId)
          && profileId == "main"
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.identityConsent is bool
          && request.resource.data.voiceConsent is bool
          && request.resource.data.movementConsent is bool;
      }

      match /twinAutomations/{automationId} {
        allow read, delete: if ownsProfile(userId);
        allow create: if ownsProfile(userId)
          && request.resource.data.userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.identityConsent == true
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.voiceConsent == true
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.movementConsent == true
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 120
          && request.resource.data.script is string
          && request.resource.data.script.size() <= 4000
          && request.resource.data.enabled is bool;
        allow update: if ownsProfile(userId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["enabled", "updatedAt"]);
      }

      match /twinRenders/{renderId} {
        allow read, delete: if ownsProfile(userId);
        allow create: if ownsProfile(userId)
          && request.resource.data.userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.identityConsent == true
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.voiceConsent == true
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.movementConsent == true
          && request.resource.data.status == "prepared"
          && request.resource.data.script is string
          && request.resource.data.script.size() > 0
          && request.resource.data.script.size() <= 4000
          && request.resource.data.sequence is list
          && request.resource.data.sequence.size() <= 40;
        allow update: if false;
      }

      match /wepi/{settingsId} {
        allow read: if ownsProfile(userId) && settingsId == "settings";
        allow create, update: if ownsProfile(userId)
          && settingsId == "settings"
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.enabled is bool
          && request.resource.data.autoReply is bool
          && request.resource.data.assistantName is string
          && request.resource.data.assistantName.size() >= 2
          && request.resource.data.assistantName.size() <= 60
          && request.resource.data.businessName is string
          && request.resource.data.businessName.size() <= 100
          && request.resource.data.tone in ["chaleureux", "expert", "direct"]
          && request.resource.data.welcomeMessage is string
          && request.resource.data.welcomeMessage.size() <= 240
          && request.resource.data.instructions is string
          && request.resource.data.instructions.size() <= 600;
        allow delete: if ownsProfile(userId) && settingsId == "settings";
      }
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(["ownerId", "conversationType", "title", "memberIds", "members", "typingBy", "readBy", "contactId", "contactName", "lastMessage", "lastSenderId", "createdAt", "updatedAt", "ephemeralSeconds"])
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 64
        && (request.resource.data.memberIds.size() == 1
          || (request.resource.data.members is list
            && request.resource.data.members.size() == request.resource.data.memberIds.size()
            && request.resource.data.typingBy is map
            && request.resource.data.readBy is map
            && (request.resource.data.memberIds.size() == 2
              || (request.resource.data.conversationType == "group"
                && request.resource.data.title is string
                && request.resource.data.title.size() >= 2
                && request.resource.data.title.size() <= 80)))
        && (!request.resource.data.keys().hasAny(["ephemeralSeconds"]) || request.resource.data.ephemeralSeconds in [0, 86400, 604800]));
      allow read: if belongsToConversation();
      allow update: if belongsToConversation()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage", "lastSenderId", "updatedAt", "typingBy", "readBy", "ephemeralSeconds"])
        && (!("lastMessage" in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000))
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastSenderId"]))
          || request.resource.data.lastSenderId == request.auth.uid)
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(["typingBy"]))
          || request.resource.data.typingBy.diff(resource.data.typingBy).affectedKeys().hasOnly([request.auth.uid]))
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(["readBy"]))
          || request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid]))
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(["ephemeralSeconds"]))
          || request.resource.data.ephemeralSeconds in [0, 86400, 604800]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(["text", "senderId", "clientMessageId", "encryptionNonce", "encryptionVersion", "kind", "mediaUrl", "mediaName", "duration", "effect", "caption", "replyToId", "replyText", "replyTo", "forwarded", "createdAt", "expiresAt", "viewOnce", "viewedBy"])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (!request.resource.data.keys().hasAny(["encryptionVersion", "encryptionNonce"])
            || (request.resource.data.encryptionVersion == 1
              && request.resource.data.encryptionNonce is string
              && request.resource.data.encryptionNonce.size() == 16))
          && (!request.resource.data.keys().hasAny(["replyToId", "replyText"])
            || (request.resource.data.replyToId is string
              && request.resource.data.replyToId.size() > 0
              && request.resource.data.replyText is string
              && request.resource.data.replyText.size() <= 240))
          && (!request.resource.data.keys().hasAny(["kind"])
            || (request.resource.data.kind in ["image", "audio", "video"]
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.matches('https://firebasestorage.googleapis.com/.*')
              && request.resource.data.mediaName is string
              && request.resource.data.mediaName.size() <= 120
              && request.resource.data.duration is number
              && request.resource.data.duration >= 0
              && request.resource.data.duration <= 600
              && (request.resource.data.kind != "video"
                || (request.resource.data.effect in ["comic", "neon", "ink", "pop"]
                  && request.resource.data.caption is string
                  && request.resource.data.caption.size() <= 100))))
          && (!request.resource.data.keys().hasAny(["expiresAt"])
            || request.resource.data.expiresAt == null
            || (request.resource.data.expiresAt is timestamp
              && request.resource.data.expiresAt > request.time
              && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')))
          && (!request.resource.data.keys().hasAny(["viewOnce"]) || request.resource.data.viewOnce is bool)
          && (!request.resource.data.keys().hasAny(["viewedBy"]) || request.resource.data.viewedBy is map)
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
              && request.resource.data.reactions is map
              && request.resource.data.reactions.diff(resource.data.get("reactions", {})).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.reactions[request.auth.uid] in ["❤️", "👍", "😂", "😮", "🙏"])
            || (resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "kind", "mediaUrl", "mediaName", "deleted"])
              && request.resource.data.text == "Message supprimé"
              && request.resource.data.kind == "deleted"
              && request.resource.data.deleted == true
              && request.resource.data.mediaUrl == ""
              && request.resource.data.mediaName == "")
            || (resource.data.viewOnce == true
              && resource.data.senderId != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewedBy"])
              && request.resource.data.viewedBy.diff(resource.data.get("viewedBy", {})).affectedKeys().hasOnly([request.auth.uid])
              && request.resource.data.viewedBy[request.auth.uid] is timestamp)
            || (resource.data.senderId == request.auth.uid
              && resource.data.get("kind", "text") == "text"
              && resource.data.get("deleted", false) == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "edited"])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000
              && request.resource.data.edited == true)
          );
        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && resource.data.expiresAt is timestamp
          && resource.data.expiresAt <= request.time;
      }

    }

    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberCount == 1
        && request.resource.data.postCount == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 300
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 40
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.verified == false;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name == resource.data.name
        && request.resource.data.description == resource.data.description
        && request.resource.data.category == resource.data.category
        && request.resource.data.ownerName == resource.data.ownerName
        && request.resource.data.verified == resource.data.verified
        && (
          (request.auth.uid == resource.data.ownerId
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.memberCount == resource.data.memberCount
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastPost", "postCount", "updatedAt"]))
          || (request.auth.uid != resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds", "memberCount", "updatedAt"])
            && request.resource.data.memberCount == request.resource.data.memberIds.size()
            && request.resource.data.memberCount >= 1
            && request.resource.data.memberCount <= 100000
            && (
              (request.resource.data.memberIds.hasAll(resource.data.memberIds)
                && request.auth.uid in request.resource.data.memberIds
                && !(request.auth.uid in resource.data.memberIds)
                && request.resource.data.memberCount == resource.data.memberCount + 1)
              || (resource.data.memberIds.hasAll(request.resource.data.memberIds)
                && request.auth.uid in resource.data.memberIds
                && !(request.auth.uid in request.resource.data.memberIds)
                && request.resource.data.memberCount == resource.data.memberCount - 1)
            ))
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /pilot/{settingsId} {
        allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if signedIn()
          && settingsId == "wepi"
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.roomId == channelId
          && request.resource.data.enabled is bool
          && request.resource.data.autoModeration is bool
          && request.resource.data.announcementAssist is bool
          && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId == request.auth.uid;
        allow update: if signedIn()
          && settingsId == "wepi"
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.roomId == resource.data.roomId
          && request.resource.data.enabled is bool
          && request.resource.data.autoModeration is bool
          && request.resource.data.announcementAssist is bool;
        allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      }

      match /posts/{postId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.reactions == {}
          && request.resource.data.pinned == false
          && request.resource.data.deleted == false;
        allow update: if signedIn() && (
          (request.auth.uid in get(/databases/$(database)/documents/channels/$(channelId)).data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions"])
            && request.resource.data.reactions is map
            && request.resource.data.reactions.diff(resource.data.get("reactions", {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.reactions[request.auth.uid] in ["❤️", "👍", "🔥", "👏", "💡"])
          || (request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pinned"]))
          || (request.auth.uid == get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "deleted", "pinned"])
            && request.resource.data.text == "Publication supprimée"
            && request.resource.data.deleted == true
            && request.resource.data.pinned == false)
        );
        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberNames is list
        && request.resource.data.memberNames.size() <= 999
        && (!request.resource.data.keys().hasAny(["inviteToken"])
          || (request.resource.data.inviteToken is string
            && request.resource.data.inviteToken.size() == 32));
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn() && (
          (request.auth.uid in resource.data.memberIds
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage", "updatedAt"]))
          || (request.auth.uid == resource.data.ownerId
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.memberIds.size() <= 999
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberNames.size() <= 999
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["inviteToken"])
              || (request.resource.data.inviteToken is string && request.resource.data.inviteToken.size() == 32))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["photoUrl"])
              || request.resource.data.photoUrl is string)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds", "memberNames", "lastMessage", "inviteToken", "photoUrl", "updatedAt"])));
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.senderId == resource.data.senderId
          && (
            (resource.data.senderId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text", "kind", "mediaUrl", "mediaName", "deleted", "edited"]))
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reactions", "viewedBy", "viewerNames"])
          );
        allow delete: if false;
      }

      match /activities/{activityId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.type in ["poll", "event", "announcement"]
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 160
          && request.resource.data.options is list
          && request.resource.data.options.size() <= 8
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if signedIn()
          && resource.data.creatorId == request.auth.uid
          && request.resource.data.creatorId == resource.data.creatorId;

        match /responses/{responseId} {
          allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow create: if signedIn()
            && responseId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.kind in ["poll", "event"]
            && request.resource.data.keys().hasOnly(["userId", "kind", "optionIndex", "attending", "updatedAt"])
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow update: if signedIn()
            && responseId == request.auth.uid
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["optionIndex", "attending", "updatedAt"])
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow delete: if signedIn() && responseId == request.auth.uid;
        }
      }
    }

    match /groupJoinRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.groupId is string
        && request.resource.data.ownerId is string
        && request.resource.data.inviteToken is string
        && request.resource.data.inviteToken.size() == 32
        && request.resource.data.userName is string
        && request.resource.data.userName.size() >= 2
        && request.resource.data.userName.size() <= 80
        && request.resource.data.status == "pending"
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteToken == request.resource.data.inviteToken;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.inviteToken == resource.data.inviteToken
        && request.resource.data.status in ["approved", "declined"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "reviewedAt"]);
      allow delete: if false;
    }

    match /whaptexts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 600
        && request.resource.data.tone in ["hope", "action", "community", "warning"]
        && request.resource.data.kind in ["status", "whaptext"];
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 600
        && request.resource.data.tone in ["hope", "action", "community", "warning"]
        && request.resource.data.kind in ["status", "whaptext"];
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /stories/{storyId} {
      allow read: if signedIn() && resource.data.expiresAt > request.time;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaType in ["text", "image", "video", "audio"]
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 600
        && request.resource.data.storagePath is string
        && ((request.resource.data.mediaType == "text"
              && request.resource.data.caption.size() >= 1
              && request.resource.data.mediaUrl == ""
              && request.resource.data.storagePath == "")
          || (request.resource.data.mediaType in ["image", "video", "audio"]
              && request.resource.data.mediaUrl.matches('https://firebasestorage.googleapis.com/.*')
              && request.resource.data.storagePath.matches('stories/' + request.auth.uid + '/.*')))
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && request.resource.data.keys().hasOnly(["authorId", "authorName", "mediaUrl", "mediaType", "caption", "storagePath", "createdAt", "expiresAt"]);
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.callerName is string
        && request.resource.data.calleeName is string
        && request.resource.data.video is bool
        && request.resource.data.offer is map
        && request.resource.data.status == "ringing"
        && request.resource.data.keys().hasOnly(["callerId", "calleeId", "callerName", "calleeName", "video", "status", "offer", "createdAt", "updatedAt"]);
      allow read: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["answer", "status", "updatedAt"])
        && request.resource.data.status in ["accepted", "declined", "ended"]
        && ((resource.data.status == "ringing"
              && request.resource.data.status in ["accepted", "declined"]
              && request.auth.uid == resource.data.calleeId
              && (request.resource.data.status != "accepted" || request.resource.data.answer is map))
          || (request.resource.data.status == "ended"
              && resource.data.status in ["ringing", "accepted"]));
      allow delete: if false;

      match /{candidateCollection}/{candidateId} {
        allow read: if signedIn()
          && candidateCollection in ["callerCandidates", "calleeCandidates"]
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        allow create: if signedIn()
          && candidateCollection in ["callerCandidates", "calleeCandidates"]
          && ((candidateCollection == "callerCandidates"
                && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid)
            || (candidateCollection == "calleeCandidates"
                && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid));
        allow update, delete: if false;
      }
    }

    match /businessPages/{pageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.handle is string
        && request.resource.data.handle.size() >= 3
        && request.resource.data.handle.size() <= 50
        && request.resource.data.type in ["business", "creator", "organization"]
        && request.resource.data.category is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 400
        && request.resource.data.status == "active"
        && request.resource.data.followers == 0;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.followers == resource.data.followers
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 400
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["logoUrl"])
          || request.resource.data.logoUrl is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["coverUrl"])
          || request.resource.data.coverUrl is string)
        && request.resource.data.type in ["business", "creator", "organization"]
        && request.resource.data.status in ["active", "hidden"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "searchName", "type", "category", "bio", "city", "phone", "website", "logoUrl", "coverUrl", "status", "updatedAt"]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /artists/{artistId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(["ownerId", "name", "stageName", "discipline", "city", "contact", "email", "status", "isScouted", "nextAction", "monthlyBudget", "notes", "createdAt", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.stageName is string
        && request.resource.data.stageName.size() >= 2
        && request.resource.data.stageName.size() <= 100
        && request.resource.data.discipline is string
        && request.resource.data.discipline.size() >= 2
        && request.resource.data.discipline.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.status in ["prospect", "active", "paused", "archived"]
        && request.resource.data.nextAction is string
        && request.resource.data.nextAction.size() <= 120
        && request.resource.data.monthlyBudget is number
        && request.resource.data.monthlyBudget >= 0
        && (!("isScouted" in request.resource.data) || request.resource.data.isScouted in [true, false])
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 600;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.stageName is string
        && request.resource.data.stageName.size() >= 2
        && request.resource.data.stageName.size() <= 100
        && request.resource.data.discipline is string
        && request.resource.data.discipline.size() >= 2
        && request.resource.data.discipline.size() <= 80
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.status in ["prospect", "active", "paused", "archived"]
        && request.resource.data.nextAction is string
        && request.resource.data.nextAction.size() <= 120
        && request.resource.data.monthlyBudget is number
        && request.resource.data.monthlyBudget >= 0
        && request.resource.data.isScouted in [true, false]
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 600
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "stageName", "discipline", "city", "contact", "email", "status", "isScouted", "nextAction", "monthlyBudget", "notes", "updatedAt"]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /liveSessions/{liveId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 60
        && request.resource.data.productTitle is string
        && request.resource.data.productTitle.size() <= 120
        && request.resource.data.hostMode in ["personal", "creator", "business"]
        && request.resource.data.visibility in ["public", "contacts", "private"]
        && request.resource.data.status in ["scheduled", "live"]
        && request.resource.data.viewerCount == 0
        && request.resource.data.streamProvider == "unconfigured";
      allow update: if signedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.status in ["scheduled", "live", "ended"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "startedAt", "endedAt", "updatedAt"]);
      allow delete: if false;
    }

    match /businessDeals/{dealId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/businessPages/$(request.resource.data.pageId)).data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 400
        && request.resource.data.originalPrice is number
        && request.resource.data.originalPrice > 0
        && request.resource.data.dealPrice is number
        && request.resource.data.dealPrice > 0
        && request.resource.data.dealPrice <= request.resource.data.originalPrice
        && request.resource.data.stock is number
        && request.resource.data.stock > 0
        && request.resource.data.stock <= 100000
        && request.resource.data.sold == 0
        && request.resource.data.status == "active";
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.pageId == resource.data.pageId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "description", "stock", "endsAt", "status", "updatedAt"])
        && request.resource.data.status in ["active", "paused", "ended"];
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /paymentNotifications/{noticeId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if false;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /adCampaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(["ownerId", "pageId", "pageName", "objective", "placement", "destination", "title", "creative", "cta", "audience", "city", "phone", "link", "estimatedReach", "dailyBudget", "days", "totalBudget", "status", "createdAt", "updatedAt"])
        && get(/databases/$(database)/documents/businessPages/$(request.resource.data.pageId)).data.ownerId == request.auth.uid
        && request.resource.data.objective in ["reach", "messages", "traffic", "sales"]
        && request.resource.data.placement in ["profile_story", "inbox", "market", "live"]
        && request.resource.data.destination in ["message", "page", "call", "website"]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120
        && request.resource.data.creative is string
        && request.resource.data.creative.size() >= 2
        && request.resource.data.creative.size() <= 600
        && request.resource.data.cta is string
        && request.resource.data.cta.size() <= 40
        && request.resource.data.audience is string
        && request.resource.data.audience.size() <= 120
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.link is string
        && request.resource.data.link.size() <= 180
        && request.resource.data.estimatedReach is number
        && request.resource.data.estimatedReach >= 120
        && request.resource.data.dailyBudget is number
        && request.resource.data.dailyBudget >= 500
        && request.resource.data.days is number
        && request.resource.data.days >= 1
        && request.resource.data.days <= 90
        && request.resource.data.totalBudget == request.resource.data.dailyBudget * request.resource.data.days
        && request.resource.data.status == "active";
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ["active", "paused", "completed"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /adEvents/{eventId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(["campaignId", "ownerId", "userId", "type", "createdAt"])
        && request.resource.data.type in ["impression", "click"]
        && get(/databases/$(database)/documents/adCampaigns/$(request.resource.data.campaignId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(database)/documents/adCampaigns/$(request.resource.data.campaignId)).data.status == "active";
      allow update, delete: if false;
    }

    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 1
        && request.resource.data.title.size() <= 120;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 1
        && request.resource.data.title.size() <= 160;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.reference is string
        && request.resource.data.customerName is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.status == "pending";
      allow read: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && resource.data.status == "pending"
        && request.resource.data.status == "cancelled";
      allow delete: if false;
    }

    match /businessSettings/{ownerId} {
      allow read: if ownsProfile(ownerId);
      allow create, update: if ownsProfile(ownerId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.currency in ["XAF", "XOF", "CDF", "USD", "EUR"]
        && request.resource.data.defaultKind in ["product", "service"];
      allow delete: if false;
    }

    match /businessOffers/{offerId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.kind in ["product", "service"]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.currency in ["XAF", "XOF", "CDF", "USD", "EUR"]
        && request.resource.data.status in ["active", "draft"];
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /businessLeads/{leadId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.need is string
        && request.resource.data.need.size() <= 180
        && request.resource.data.stage in ["new", "contacted", "qualified", "won", "lost"];
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /whappyTeam/{memberId} {
      allow read: if whappyFounder() && resource.data.ownerId == request.auth.uid;
      allow create: if whappyFounder()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.role is string
        && request.resource.data.role.size() >= 2
        && request.resource.data.role.size() <= 100
        && request.resource.data.status in ["active", "invited", "paused"];
      allow update: if whappyFounder()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }

    match /whappyEarnings/{earningId} {
      allow read: if whappyFounder() && resource.data.ownerId == request.auth.uid;
      allow create: if whappyFounder()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency in ["XAF", "XOF", "CDF", "USD", "EUR"]
        && request.resource.data.status in ["pending", "processing", "paid"];
      allow update: if whappyFounder()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;
    }
  }
}
