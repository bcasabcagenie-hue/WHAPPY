rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function belongsToConversation() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if ownsProfile(userId);

      match /devices/{deviceId} {
        allow read, delete: if ownsProfile(userId);
        allow create, update: if ownsProfile(userId)
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 20
          && request.resource.data.platform == "android"
          && request.resource.data.enabled is bool;
      }

      match /twinProfiles/{profileId} {
        allow read, delete: if ownsProfile(userId) && profileId == "main";
        allow create, update: if ownsProfile(userId)
          && profileId == "main"
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.identityConsent is bool
          && request.resource.data.voiceConsent is bool
          && request.resource.data.movementConsent is bool;
      }

      match /twinAutomations/{automationId} {
        allow read, delete: if ownsProfile(userId);
        allow create: if ownsProfile(userId)
          && request.resource.data.userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.identityConsent == true
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.voiceConsent == true
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.movementConsent == true
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 120
          && request.resource.data.script is string
          && request.resource.data.script.size() <= 4000
          && request.resource.data.enabled is bool;
        allow update: if ownsProfile(userId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["enabled", "updatedAt"]);
      }

      match /twinRenders/{renderId} {
        allow read, delete: if ownsProfile(userId);
        allow create: if ownsProfile(userId)
          && request.resource.data.userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.identityConsent == true
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.voiceConsent == true
          && get(/databases/$(database)/documents/users/$(userId)/twinProfiles/main).data.movementConsent == true
          && request.resource.data.status == "prepared"
          && request.resource.data.script is string
          && request.resource.data.script.size() > 0
          && request.resource.data.script.size() <= 4000
          && request.resource.data.sequence is list
          && request.resource.data.sequence.size() <= 40;
        allow update: if false;
      }
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(["ownerId", "memberIds", "members", "typingBy", "readBy", "contactId", "contactName", "updatedAt"])
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 2
        && (request.resource.data.memberIds.size() == 1
          || (request.resource.data.members is list
            && request.resource.data.members.size() == 2
            && request.resource.data.typingBy is map
            && request.resource.data.readBy is map));
      allow read: if belongsToConversation();
      allow update: if belongsToConversation()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage", "updatedAt", "typingBy", "readBy"])
        && (!("lastMessage" in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000))
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(["typingBy"]))
          || request.resource.data.typingBy.diff(resource.data.typingBy).affectedKeys().hasOnly([request.auth.uid]))
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(["readBy"]))
          || request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(["text", "senderId", "kind", "mediaUrl", "mediaName", "duration", "effect", "caption", "createdAt"])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (!request.resource.data.keys().hasAny(["kind"])
            || (request.resource.data.kind in ["image", "audio", "video"]
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.matches('https://firebasestorage.googleapis.com/.*')
              && request.resource.data.mediaName is string
              && request.resource.data.mediaName.size() <= 120
              && request.resource.data.duration is number
              && request.resource.data.duration >= 0
              && request.resource.data.duration <= 600
              && (request.resource.data.kind != "video"
                || (request.resource.data.effect in ["comic", "neon", "ink", "pop"]
                  && request.resource.data.caption is string
                  && request.resource.data.caption.size() <= 100))))
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow update, delete: if false;
      }

    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberNames is list
        && request.resource.data.memberNames.size() <= 999;
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage", "updatedAt"]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if false;
      }

      match /activities/{activityId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.type in ["poll", "event", "announcement"]
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 160
          && request.resource.data.options is list
          && request.resource.data.options.size() <= 8
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if signedIn()
          && resource.data.creatorId == request.auth.uid
          && request.resource.data.creatorId == resource.data.creatorId;

        match /responses/{responseId} {
          allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow create: if signedIn()
            && responseId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.kind in ["poll", "event"]
            && request.resource.data.keys().hasOnly(["userId", "kind", "optionIndex", "attending", "updatedAt"])
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow update: if signedIn()
            && responseId == request.auth.uid
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["optionIndex", "attending", "updatedAt"])
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow delete: if signedIn() && responseId == request.auth.uid;
        }
      }
    }

    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.callerName is string
        && request.resource.data.calleeName is string
        && request.resource.data.video is bool
        && request.resource.data.offer is map
        && request.resource.data.status == "ringing"
        && request.resource.data.keys().hasOnly(["callerId", "calleeId", "callerName", "calleeName", "video", "status", "offer", "createdAt", "updatedAt"]);
      allow read: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["answer", "status", "updatedAt"])
        && request.resource.data.status in ["accepted", "declined", "ended"]
        && ((resource.data.status == "ringing"
              && request.resource.data.status in ["accepted", "declined"]
              && request.auth.uid == resource.data.calleeId
              && (request.resource.data.status != "accepted" || request.resource.data.answer is map))
          || (request.resource.data.status == "ended"
              && resource.data.status in ["ringing", "accepted"]));
      allow delete: if false;

      match /{candidateCollection}/{candidateId} {
        allow read: if signedIn()
          && candidateCollection in ["callerCandidates", "calleeCandidates"]
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
        allow create: if signedIn()
          && candidateCollection in ["callerCandidates", "calleeCandidates"]
          && ((candidateCollection == "callerCandidates"
                && get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid)
            || (candidateCollection == "calleeCandidates"
                && get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid));
        allow update, delete: if false;
      }
    }

    match /businessPages/{pageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.handle is string
        && request.resource.data.handle.size() >= 3
        && request.resource.data.handle.size() <= 50
        && request.resource.data.type in ["business", "creator", "organization"]
        && request.resource.data.category is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 400
        && request.resource.data.status == "active"
        && request.resource.data.followers == 0;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.handle == resource.data.handle
        && request.resource.data.followers == resource.data.followers
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 400
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["logoUrl"])
          || request.resource.data.logoUrl is string)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["coverUrl"])
          || request.resource.data.coverUrl is string)
        && request.resource.data.type in ["business", "creator", "organization"]
        && request.resource.data.status in ["active", "hidden"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "searchName", "type", "category", "bio", "city", "phone", "website", "logoUrl", "coverUrl", "status", "updatedAt"]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /liveSessions/{liveId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 60
        && request.resource.data.productTitle is string
        && request.resource.data.productTitle.size() <= 120
        && request.resource.data.hostMode in ["personal", "creator", "business"]
        && request.resource.data.visibility in ["public", "contacts", "private"]
        && request.resource.data.status in ["scheduled", "live"]
        && request.resource.data.viewerCount == 0
        && request.resource.data.streamProvider == "unconfigured";
      allow update: if signedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.status in ["scheduled", "live", "ended"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "startedAt", "endedAt", "updatedAt"]);
      allow delete: if false;
    }

    match /businessDeals/{dealId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/businessPages/$(request.resource.data.pageId)).data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 400
        && request.resource.data.originalPrice is number
        && request.resource.data.originalPrice > 0
        && request.resource.data.dealPrice is number
        && request.resource.data.dealPrice > 0
        && request.resource.data.dealPrice <= request.resource.data.originalPrice
        && request.resource.data.stock is number
        && request.resource.data.stock > 0
        && request.resource.data.stock <= 100000
        && request.resource.data.sold == 0
        && request.resource.data.status == "active";
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.pageId == resource.data.pageId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "description", "stock", "endsAt", "status", "updatedAt"])
        && request.resource.data.status in ["active", "paused", "ended"];
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /paymentNotifications/{noticeId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if false;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"])
        && request.resource.data.read == true;
      allow delete: if false;
    }

    match /adCampaigns/{campaignId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(["ownerId", "pageId", "pageName", "objective", "title", "creative", "cta", "audience", "city", "dailyBudget", "days", "totalBudget", "status", "createdAt", "updatedAt"])
        && get(/databases/$(database)/documents/businessPages/$(request.resource.data.pageId)).data.ownerId == request.auth.uid
        && request.resource.data.objective in ["reach", "messages", "traffic", "sales"]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120
        && request.resource.data.creative is string
        && request.resource.data.creative.size() >= 2
        && request.resource.data.creative.size() <= 600
        && request.resource.data.cta is string
        && request.resource.data.cta.size() <= 40
        && request.resource.data.audience is string
        && request.resource.data.audience.size() <= 120
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.dailyBudget is number
        && request.resource.data.dailyBudget >= 500
        && request.resource.data.days is number
        && request.resource.data.days >= 1
        && request.resource.data.days <= 90
        && request.resource.data.totalBudget == request.resource.data.dailyBudget * request.resource.data.days
        && request.resource.data.status == "active";
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status in ["active", "paused", "completed"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /adEvents/{eventId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(["campaignId", "ownerId", "userId", "type", "createdAt"])
        && request.resource.data.type in ["impression", "click"]
        && get(/databases/$(database)/documents/adCampaigns/$(request.resource.data.campaignId)).data.ownerId == request.resource.data.ownerId
        && get(/databases/$(database)/documents/adCampaigns/$(request.resource.data.campaignId)).data.status == "active";
      allow update, delete: if false;
    }

    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 1
        && request.resource.data.title.size() <= 120;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 1
        && request.resource.data.title.size() <= 160;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.reference is string
        && request.resource.data.customerName is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.status == "pending";
      allow read: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && resource.data.status == "pending"
        && request.resource.data.status == "cancelled";
      allow delete: if false;
    }
  }
}
