rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function belongsToConversation() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if ownsProfile(userId);
    }

    match /conversations/{conversationId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      allow read: if belongsToConversation();
      allow update: if belongsToConversation()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow update, delete: if false;
      }

    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberNames is list
        && request.resource.data.memberNames.size() <= 999;
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage", "updatedAt"]);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if false;
      }

      match /activities/{activityId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if signedIn()
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.type in ["poll", "event", "announcement"]
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 160
          && request.resource.data.options is list
          && request.resource.data.options.size() <= 8
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if signedIn()
          && resource.data.creatorId == request.auth.uid
          && request.resource.data.creatorId == resource.data.creatorId;

        match /responses/{responseId} {
          allow read: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow create: if signedIn()
            && responseId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.kind in ["poll", "event"]
            && request.resource.data.keys().hasOnly(["userId", "kind", "optionIndex", "attending", "updatedAt"])
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow update: if signedIn()
            && responseId == request.auth.uid
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["optionIndex", "attending", "updatedAt"])
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          allow delete: if signedIn() && responseId == request.auth.uid;
        }
      }
    }

    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 1
        && request.resource.data.title.size() <= 120;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 1
        && request.resource.data.title.size() <= 160;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.reference is string
        && request.resource.data.customerName is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.status == "pending";
      allow read: if signedIn() && resource.data.buyerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
        && resource.data.status == "pending"
        && request.resource.data.status == "cancelled";
      allow delete: if false;
    }
  }
}
