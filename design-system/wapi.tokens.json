{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "WAPI Native Design System",
    "version": "3.0.0",
    "platforms": ["android", "ios"]
  },
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#148AF2" },
      "deep": { "$type": "color", "$value": "#0B6FD8" },
      "sky": { "$type": "color", "$value": "#50C9EA" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#11243D" },
      "secondary": { "$type": "color", "$value": "#64748B" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" }
    },
    "surface": {
      "canvas": { "$type": "color", "$value": "#F1F5FA" },
      "primary": { "$type": "color", "$value": "#FFFFFF" },
      "secondary": { "$type": "color", "$value": "#EAF1F8" },
      "line": { "$type": "color", "$value": "#D7E1EC" }
    },
    "semantic": {
      "verified": { "$type": "color", "$value": "#858D96" },
      "live": { "$type": "color", "$value": "#F0445A" },
      "success": { "$type": "color", "$value": "#1F9D68" },
      "warning": { "$type": "color", "$value": "#E58A00" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "sm": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "compact": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "control": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "panel": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
    "hero": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } }
  }
}
