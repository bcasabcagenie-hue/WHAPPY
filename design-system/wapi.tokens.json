{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "WAPI Native Design System",
    "version": "5.1.0",
    "platforms": ["android", "ios"]
  },
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#146FE8" },
      "deep": { "$type": "color", "$value": "#084A9B" },
      "sky": { "$type": "color", "$value": "#19BFF2" },
      "night": { "$type": "color", "$value": "#062A4C" },
      "aqua": { "$type": "color", "$value": "#00A7A0" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#0A1D32" },
      "secondary": { "$type": "color", "$value": "#647588" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" }
    },
    "surface": {
      "canvas": { "$type": "color", "$value": "#F7F9FC" },
      "primary": { "$type": "color", "$value": "#FFFFFF" },
      "secondary": { "$type": "color", "$value": "#EFF3F7" },
      "line": { "$type": "color", "$value": "#DDE4EC" }
    },
    "semantic": {
      "verified": { "$type": "color", "$value": "#858D96" },
      "live": { "$type": "color", "$value": "#F0445A" },
      "success": { "$type": "color", "$value": "#1F9D68" },
      "warning": { "$type": "color", "$value": "#E58A00" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "sm": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "compact": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "control": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "panel": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "hero": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } }
  }
}
