{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "WAPI Native Design System",
    "version": "2.0.0",
    "platforms": ["android", "ios"]
  },
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#0094F0" },
      "deep": { "$type": "color", "$value": "#0066CF" },
      "sky": { "$type": "color", "$value": "#00A2E6" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#171717" },
      "secondary": { "$type": "color", "$value": "#73777D" },
      "inverse": { "$type": "color", "$value": "#FFFFFF" }
    },
    "surface": {
      "canvas": { "$type": "color", "$value": "#F5F5F5" },
      "primary": { "$type": "color", "$value": "#FFFFFF" },
      "secondary": { "$type": "color", "$value": "#F5F5F5" },
      "line": { "$type": "color", "$value": "#E7E7E7" }
    },
    "semantic": {
      "verified": { "$type": "color", "$value": "#858D96" },
      "live": { "$type": "color", "$value": "#F0445A" },
      "success": { "$type": "color", "$value": "#1F9D68" },
      "warning": { "$type": "color", "$value": "#E58A00" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "sm": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "lg": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "compact": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "control": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } },
    "panel": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
    "hero": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } }
  }
}
